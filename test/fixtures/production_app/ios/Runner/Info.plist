<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Acme Shop: one Info.plist for every flavor. Values that differ between dev
  and prod come from the xcconfig that ios/scripts/select_flavor.sh selects,
  never from a second copy of this file.
-->
<plist version="1.0">
<dict>
	<!-- ===================== Identity ===================== -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>acme_shop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Languages. Keep in sync with lib/l10n/arb (one ARB file per entry). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<!-- Brazilian Portuguese, added in 3.2 -->
		<string>pt-BR</string>
	</array>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>acmeshop</string>
				<!-- Reversed client ID, different for dev and prod -->
				<string>$(REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<key>FirebaseAppDelegateProxyEnabled</key>
	<!-- Messaging is wired up by hand in AppDelegate.swift. -->
	<false/>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>mailto</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ===================== Purpose strings =====================
	     Each string names the feature and gives an example. The two location
	     keys are only here because the card SDK inside acme_payments
	     references CoreLocation; the app never asks for location. -->
	<key>NSCameraUsageDescription</key>
	<string>Point the camera at a product barcode to look it up in the catalog, for example the code on a shelf label in one of our stores.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID confirms it is you before paying with a saved card, for example when you check out an order without typing your password.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Acme Shop does not use your location. The payment SDK bundled with the app references location APIs, so iOS requires this text; the app never asks for your location.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Acme Shop does not use your location. The payment SDK bundled with the app references location APIs, so iOS requires this text; the app never asks for your location.</string>

